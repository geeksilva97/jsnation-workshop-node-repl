{
  "name": "park42",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "knex": "tsx ./node_modules/.bin/knex",
    "check": "biome check --write",
    "dev": "tsx --watch src/index.ts",
    "dev:db:migration:create": "npm run knex migrate:make",
    "dev:db:create": "createdbjs park42_development --user=postgres --password=postgres --host=127.0.0.1",
    "dev:db:drop": "dropdbjs park42_development --user=postgres --password=postgres --host=127.0.0.1",
    "dev:db:migrate": "npm run knex migrate:latest",
    "dev:db:rollback": "npm run knex migrate:rollback",
    "dev:db:seed": "npm run knex seed:run",
    "dev:worker": "tsx --watch src/infrastructure/queue/worker.ts",
    "test": "tsx ./node_modules/.bin/vitest",
    "test:db:create": "createdbjs park42_test --user=postgres --password=postgres --host=127.0.0.1",
    "test:db:drop": "dropdbjs park42_test --user=postgres --password=postgres --host=127.0.0.1",
    "test:db:migrate": "NODE_ENV=test npm run knex migrate:latest",
    "test:db:rollback": "NODE_ENV=test npm run knex migrate:rollback"
  },
  "dependencies": {
    "@bull-board/api": "^6.11.0",
    "@bull-board/fastify": "^6.11.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@types/ioredis": "^4.28.10",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.56.1",
    "dotenv": "^17.0.1",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "knex": "^3.1.0",
    "objection": "^3.1.5",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@tsconfig/node-lts": "^22.0.2",
    "@types/bcrypt": "^5.0.2",
    "@types/knex-cleaner": "^1.3.6",
    "@types/node": "^24.0.10",
    "knex-cleaner": "^1.3.1",
    "pgtools": "^1.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
